{
  "dark_path_only": true,
  "current_turn_ui_artifact": true,
  "cases": [
    {
      "id": "text",
      "payload": {
        "role": "assistant",
        "parts": [{ "type": "text", "text": "Tôi đã tra cứu xong." }]
      }
    },
    {
      "id": "tool-card",
      "payload": {
        "type": "tool-equipmentLookup",
        "state": "output-available",
        "toolCallId": "tool-1",
        "output": { "modelSummary": { "itemCount": 1 } }
      }
    },
    {
      "id": "report-chart",
      "payload": {
        "uiArtifact": {
          "kind": "reportChart",
          "version": 1,
          "title": "Số lượng thiết bị",
          "chart": {
            "type": "bar",
            "xKey": "khoa_phong_quan_ly",
            "yKey": "so_luong",
            "data": [{ "khoa_phong_quan_ly": "ICU", "so_luong": 12 }]
          }
        }
      }
    },
    {
      "id": "repair-draft",
      "payload": {
        "kind": "repairRequestDraft",
        "version": 1,
        "draft_only": true,
        "submit": false,
        "uiArtifact": {
          "kind": "repairRequestDraft",
          "current_turn": true,
          "rawPayload": { "equipmentId": 42, "summary": "Máy báo lỗi" }
        }
      }
    },
    {
      "id": "sanitized-error",
      "payload": {
        "type": "error",
        "code": "provider_quota",
        "message": "Nhà cung cấp mô hình đang tạm thời quá tải. Vui lòng thử lại sau."
      }
    },
    {
      "id": "stop-cancel",
      "payload": {
        "requestSignal": "aborted",
        "code": "cancelled",
        "message": "Yêu cầu đã được hủy."
      }
    },
    {
      "id": "stream-completion",
      "payload": {
        "events": ["start", "text-delta", "tool-output-available", "finish", "DONE"]
      }
    },
    {
      "id": "markdown-table",
      "payload": {
        "chunks": [
          "| Thiết bị | Tình",
          " trạng | Ghi chú |\n| -",
          "-- | --- | --- |\n| Máy siêu âm | Hoạt động | Chưa",
          " có dữ liệu |\n| Máy X\\|Y | Hỏng | ",
          "<img src=x onerror=\"alert(1)\"> |\n"
        ],
        "expected": {
          "columns": ["Thiết bị", "Tình trạng", "Ghi chú"],
          "rows": [
            ["Máy siêu âm", "Hoạt động", "Chưa có dữ liệu"],
            ["Máy X|Y", "Hỏng", "<img src=x onerror=\"alert(1)\">"]
          ],
          "unicode": true,
          "escaped_pipe": true,
          "safe_cells": true
        },
        "layout": {
          "overflow_x_auto": true,
          "min_w_0": true
        }
      }
    }
  ]
}
