[Unit]
Description=QLTBYT shared AI Go service
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/qltbyt-ai
EnvironmentFile=-/etc/qltbyt-ai/ai-service.env
ExecStart=/usr/bin/docker compose --env-file /etc/qltbyt-ai/ai-service.env -f /opt/qltbyt-ai/docker-compose.yml up --detach --no-build ai-service
ExecStop=/usr/bin/docker compose --env-file /etc/qltbyt-ai/ai-service.env -f /opt/qltbyt-ai/docker-compose.yml stop --timeout 65 ai-service
TimeoutStartSec=120
TimeoutStopSec=90s
Restart=no

[Install]
WantedBy=multi-user.target
