# Copy to /etc/qltbyt-ai/ai-service.env and keep mode 0600. Do not commit the copy.
AI_SERVICE_IMAGE=
# Keep the last verified digest in the release record; set this only for rollback.
# AI_SERVICE_PREVIOUS_IMAGE=registry.example/qltbyt/ai-service@sha256:<64-hex-digest>
AI_SERVICE_MAX_CONCURRENT=16
AI_SERVICE_USAGE_DIR=/var/lib/ai-service/usage
# Host directory for the journal; prepare it as 65532:65532 mode 0700.
AI_SERVICE_USAGE_HOST_DIR=/var/lib/qltbyt-ai/usage
AI_PROVIDER_CHAIN=nvidia/google/gemma-4-31b-it,google/gemini-3.5-flash-lite
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1/chat/completions
GOOGLE_GENERATIVE_AI_BASE_URL=https://generativelanguage.googleapis.com
AI_SERVICE_HMAC_KEY_ID=
AI_SERVICE_HMAC_SECRET_FILE=/etc/qltbyt-ai/secrets/hmac.secret
AI_SERVICE_BROKER_SECRET_FILE=/etc/qltbyt-ai/secrets/broker.secret
NVIDIA_API_KEY_FILE=/etc/qltbyt-ai/secrets/nvidia.api-key
GOOGLE_GENERATIVE_AI_API_KEYS_FILE=/etc/qltbyt-ai/secrets/google.api-keys
