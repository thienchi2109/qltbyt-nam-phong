# Copy outside Git; placeholders deliberately cannot authenticate or send.
# Choose ONE standalone Compose file. Never run both consumers simultaneously.
WEB_PUSH_IMAGE=registry.example.test/web-push@sha256:<reviewed-image-digest>
# File mode: dedicated directory containing apps.json and only its VAPID keys.
WEB_PUSH_APPS_SECRET_DIR=/absolute/operator-managed/web-push-secrets
# Legacy env mode: preserve all existing QLTBYT artifacts during code upgrade.
WEB_PUSH_APP_ID=qltbyt
WEB_PUSH_ORIGIN=https://qltbyt.example.test
WEB_PUSH_WORKER_ID=oracle-web-push-1
WEB_PUSH_PAUSED=true
WEB_PUSH_HMAC_KEY_ID=<existing-current-slot>
WEB_PUSH_HMAC_SECRET=<existing-qltbyt-base64-secret>
WEB_PUSH_VAPID_KEY_VERSION=<existing-qltbyt-version>
WEB_PUSH_VAPID_PUBLIC_KEY=<existing-qltbyt-public-key>
WEB_PUSH_VAPID_FINGERPRINT=<existing-qltbyt-fingerprint>
WEB_PUSH_VAPID_SUBJECT=mailto:operator@example.test
WEB_PUSH_VAPID_PRIVATE_KEY_FILE=/absolute/operator-managed/qltbyt_vapid_private_key
